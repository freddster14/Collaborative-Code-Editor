{
  "rewrites": [
    { 
      "source": "/api/:path*", 
      "destination": "https://collaborative-code-editor-2gms.onrender.com/:path*" 
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}